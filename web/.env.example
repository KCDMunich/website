# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Public site URL used for metadata, Open Graph, and canonical links
NEXT_PUBLIC_SITE_URL=https://cloudnativesummit.de

# -----------------------------------------------------------------------------
# Site state
# -----------------------------------------------------------------------------
#
# Lifecycle (typical order): teaser → tickets → live → recap
# SPONSORSHIP_PHASE is independent — sponsor recruiting can run during recap.
#
# BUILD TIME: these values are read when Next.js starts or builds. On Vercel,
# update env vars and redeploy. Locally, restart `npm run dev` after changes.
#
# Edition dates, venues, ticket URLs, and gallery links live in lib/event-config.ts.
# Invalid EVENT_STAGE values or missing required stage content stop the build.
#
# --- Presets (copy the block that matches your situation) ---
#
# Save the date + sponsor recruiting for the next edition (current default):
#   EVENT_STAGE=teaser
#   SPONSORSHIP_PHASE=recruiting
#
# Ticket sales, program not yet public:
#   EVENT_STAGE=tickets
#   PROGRAM_PUBLISHED=false
#   TICKETS_SOLD_OUT=false
#
# Ticket sales, full program live:
#   EVENT_STAGE=tickets
#   PROGRAM_PUBLISHED=true
#
# Sold out:
#   EVENT_STAGE=tickets
#   TICKETS_SOLD_OUT=true
#
# --- Variable matrix ---
# Variable              | Active in stage(s)         | Required when set
# EVENT_STAGE           | always                     | always (teaser|tickets|live|recap)
# PROGRAM_PUBLISHED     | tickets only               | no (default false)
# TICKETS_SOLD_OUT      | tickets only               | no (default false)
# ANNOUNCED_SPEAKER_IDS | tickets (preview)          | no
# SPONSORSHIP_PHASE     | always (independent)       | no (default recruiting)
#
# Stage       Main visitor experience
# teaser      Save the date plus previous-edition schedule and speaker archive
# tickets     Ticket sales; PROGRAM_PUBLISHED and TICKETS_SOLD_OUT apply here
# live        Live/mobile schedule and on-site information
# recap       Photos, recordings, schedule archive, and partner thanks

# Single source of truth for hero copy, navigation, homepage order, program
# visibility, ticketing, route copy, and metadata.
EVENT_STAGE=teaser

# Only while EVENT_STAGE=tickets (both default to false):
#   true → publish full schedule and speaker lineup in nav and sitemap
#   true → remove purchase actions and show sold-out copy
PROGRAM_PUBLISHED=false
TICKETS_SOLD_OUT=false

# Sessionize speaker IDs, comma-separated. Shown in ticket-preview mode
# (before PROGRAM_PUBLISHED=true). When empty, the speaker homepage section,
# navigation links, and speaker hero CTA are hidden. Archive/published lineups
# remain visible. Set IDs and redeploy to show the first announcements.
ANNOUNCED_SPEAKER_IDS=

# Independent from EVENT_STAGE — recruiting can start in any event stage:
#   closed     → keep sponsor logos, hide recruiting CTAs
#   recruiting → keep logos and show next-edition sponsor CTA
SPONSORSHIP_PHASE=recruiting

# -----------------------------------------------------------------------------
# Fienta ticketing API (server-side)
# -----------------------------------------------------------------------------

FIENTA_BASE_URL=https://fienta.com/api/v1
FIENTA_EVENT_ID=201687
FIENTA_ORGANIZER_ID=36183
FIENTA_SERIES_ID=
FIENTA_LOCALE=en
# Required for individual ticket types via /events/{id}/ticket-types.
# The public events endpoint only provides event information, not ticket cards.
# Set this server-side in Vercel or .env.local; never use NEXT_PUBLIC_ for the key.
FIENTA_API_KEY=
FIENTA_EVENT_URL=https://fienta.com/cloud-native-summit-201687

# -----------------------------------------------------------------------------
# Sessionize (schedule & speakers)
# -----------------------------------------------------------------------------

SESSIONIZE_EVENT_ID=1yvxke5i

# -----------------------------------------------------------------------------
# Schedule stats (optional)
# -----------------------------------------------------------------------------

# Cloudflare Worker endpoint for anonymous schedule favorite counts
NEXT_PUBLIC_SCHEDULE_STATS_ENDPOINT=
