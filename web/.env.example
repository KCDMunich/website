# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Public site URL used for metadata, Open Graph, and canonical links
NEXT_PUBLIC_SITE_URL=https://cloudnativesummit.de

# Legacy Gatsby site URL (optional fallback for metadata)
GATSBY_DEFAULT_SITE_URL=https://cloudnativesummit.de

# -----------------------------------------------------------------------------
# Site state
# -----------------------------------------------------------------------------

# EVENT_STAGE is the single source of truth for event messaging, navigation,
# homepage order, program visibility, ticketing, route copy, and metadata.
# Invalid values and missing required stage content stop the build.
#
# Stage       Main visitor experience
# teaser      Save the date; no program or ticket links
# cfp         Call for proposals; requires CFP_URL
# tickets     Ticket sales; options below control published program and sold-out
# live        Live/mobile schedule and on-site information
# recap       Photos, recordings, schedule archive, and partner thanks
EVENT_STAGE=recap

# Only used while EVENT_STAGE=tickets:
#   PROGRAM_PUBLISHED=true  → publish the full schedule and speaker lineup
#   TICKETS_SOLD_OUT=true   → remove purchase actions and show sold-out copy
# Both default to false.
PROGRAM_PUBLISHED=false
TICKETS_SOLD_OUT=false

# Speaker visibility:
#   EVENT_STAGE=cfp                              → show only announcedSpeakerIds
#   EVENT_STAGE=tickets + PROGRAM_PUBLISHED=false → show only announcedSpeakerIds
#   EVENT_STAGE=tickets + PROGRAM_PUBLISHED=true  → publish full lineup and schedule
# Add Sessionize speaker IDs as a comma-separated list. Each ID is displayed in
# CFP and ticket-preview mode; leave empty to show no speaker cards yet.
ANNOUNCED_SPEAKER_IDS=

# Required only while EVENT_STAGE=cfp. The public submission form opened by
# the "Submit a proposal" CTA. Leave empty in every other phase.
CFP_URL=

# Sponsorship remains independent so recruiting can start during recap:
#   closed     = keep existing sponsor logos, hide recruiting CTAs
#   recruiting = keep existing logos and show the next-edition sponsor CTA
SPONSORSHIP_PHASE=recruiting

# -----------------------------------------------------------------------------
# Fienta ticketing API (server-side)
# -----------------------------------------------------------------------------

# Fienta REST API base URL
FIENTA_BASE_URL=https://fienta.com/api/v1

# Required: Fienta event ID used to fetch ticket data
FIENTA_EVENT_ID=

# Optional: organizer and series filters for public event listing
FIENTA_ORGANIZER_ID=
FIENTA_SERIES_ID=

# Locale for localized ticket/event copy (default: de)
FIENTA_LOCALE=de

# Private API key for authenticated Fienta endpoints (ticket types, etc.)
FIENTA_API_KEY=

# Fallback checkout URL when the API does not return one.
# Set this only for the active ticket-sales edition.
FIENTA_EVENT_URL=

# Client-side proxy path for ticket components (default: /api/fienta-event)
NEXT_PUBLIC_FIENTA_PROXY_URL=/api/fienta-event

# Legacy Gatsby env names (optional fallbacks)
GATSBY_FIENTA_BASE_URL=https://fienta.com/api/v1
GATSBY_FIENTA_EVENT_ID=
GATSBY_FIENTA_ORGANIZER_ID=
GATSBY_FIENTA_SERIES_ID=
GATSBY_FIENTA_LOCALE=de
GATSBY_FIENTA_EVENT_URL=
GATSBY_FIENTA_PROXY_URL=/api/fienta-event

# -----------------------------------------------------------------------------
# Sessionize (schedule & speakers)
# -----------------------------------------------------------------------------

SESSIONIZE_EVENT_ID=1yvxke5i

# -----------------------------------------------------------------------------
# Schedule stats (optional)
# -----------------------------------------------------------------------------

# Cloudflare Worker endpoint for anonymous favorite counts
NEXT_PUBLIC_SCHEDULE_STATS_ENDPOINT=
SCHEDULE_STATS_ENDPOINT=
GATSBY_SCHEDULE_STATS_ENDPOINT=

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

GATSBY_DEV_SSR=false
