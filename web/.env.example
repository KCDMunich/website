# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Public site URL used for metadata, Open Graph, and canonical links
NEXT_PUBLIC_SITE_URL=https://cloudnativesummit.de

# Legacy Gatsby site URL (optional fallback for metadata)
GATSBY_DEFAULT_SITE_URL=https://cloudnativesummit.de

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------

# Show the "Tickets / Secure your spot" section on the homepage.
# Set to "true" when ticket sales go live. Any other value (or unset) keeps it hidden.
# Vercel: Project → Settings → Environment Variables → redeploy after changing.
SHOW_TICKETING_SECTION=false

# Homepage speakers section phase:
#   off        — hidden (no active event)
#   announced  — curated pre-announced speakers (see PRE_ANNOUNCED_SPEAKER_IDS)
#   lineup     — speaker wall (10 speakers, 5×2 grid) + link to /speakers
SPEAKERS_SECTION_MODE=off

# -----------------------------------------------------------------------------
# Fienta ticketing API (server-side)
# -----------------------------------------------------------------------------

# Fienta REST API base URL
FIENTA_BASE_URL=https://fienta.com/api/v1

# Required: Fienta event ID used to fetch ticket data
FIENTA_EVENT_ID=

# Optional: organizer and series filters for public event listing
FIENTA_ORGANIZER_ID=
FIENTA_SERIES_ID=

# Locale for localized ticket/event copy (default: de)
FIENTA_LOCALE=de

# Private API key for authenticated Fienta endpoints (ticket types, etc.)
FIENTA_API_KEY=

# Fallback checkout URL when the API does not return one
FIENTA_EVENT_URL=https://fienta.com/de/cloud-native-summit-2026

# Client-side proxy path for ticket components (default: /api/fienta-event)
NEXT_PUBLIC_FIENTA_PROXY_URL=/api/fienta-event

# Legacy Gatsby env names (optional fallbacks)
GATSBY_FIENTA_BASE_URL=https://fienta.com/api/v1
GATSBY_FIENTA_EVENT_ID=
GATSBY_FIENTA_ORGANIZER_ID=
GATSBY_FIENTA_SERIES_ID=
GATSBY_FIENTA_LOCALE=de
GATSBY_FIENTA_EVENT_URL=https://fienta.com/de/cloud-native-summit-2026
GATSBY_FIENTA_PROXY_URL=/api/fienta-event

# -----------------------------------------------------------------------------
# Sessionize (schedule & speakers)
# -----------------------------------------------------------------------------

SESSIONIZE_EVENT_ID=1yvxke5i

# -----------------------------------------------------------------------------
# Schedule stats (optional)
# -----------------------------------------------------------------------------

# Cloudflare Worker endpoint for anonymous favorite counts
NEXT_PUBLIC_SCHEDULE_STATS_ENDPOINT=
SCHEDULE_STATS_ENDPOINT=
GATSBY_SCHEDULE_STATS_ENDPOINT=

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

GATSBY_DEV_SSR=false